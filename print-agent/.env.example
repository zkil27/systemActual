# Copy this file to .env on the warehouse PC and fill it in.

# Your Kyna Ops address (no trailing slash)
KYNA_URL="https://your-app.vercel.app"

# The code from Kyna Ops > Settings > Printer > "Set up printer PC"
DEVICE_TOKEN=""

# Exact printer name. List them with:  npm run printers   (leave blank for the Windows default printer)
PRINTER_NAME=""

# Label size: 4x6 for 4x6 in labels, A6 for A6 labels
PAPER_SIZE="4x6"

# shrink (default): labels that fit print at 100%, bigger ones are scaled down instead of cut off.
# noscale: always 100% (edges get cut if the label is bigger than the sticker).
PRINT_SCALE="shrink"

# on (default): also runs the app's sync every minute. Set to off on a PC that is only testing a printer.
SYNC_CLOCK="on"

# Leave blank on the warehouse PC. Set to TEST on a PC that should only print test pages, never real labels.
PRINT_ONLY=""

# Optional nightly database backup. Needs pg_dump (PostgreSQL client tools) installed.
# Use the Supabase "Session pooler" / direct connection string (port 5432). Leave blank to skip.
BACKUP_DATABASE_URL=""
BACKUP_DIR="C:\\KynaBackups"
# Local hour (0-23) after which the day's backup runs, while the PC is on.
BACKUP_HOUR="18"
BACKUP_KEEP="7"
