{
  "name": "kyna-print-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Runs on the warehouse PC: prints Kyna Ops labels silently and keeps the app's sync running every minute.",
  "scripts": {
    "start": "node --env-file=.env agent.mjs",
    "printers": "node -e \"import('pdf-to-printer').then(async m => console.log((await (m.getPrinters || m.default.getPrinters)()).map(p => p.name).join('\\n')))\""
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "pdf-to-printer": "^5.8.1"
  }
}
