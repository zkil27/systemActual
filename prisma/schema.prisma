generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Platform {
  SHOPEE
  TIKTOK
}

enum ReturnCategory {
  FAILED_DELIVERY
  RETURN_REFUND
}

enum DigitalStatus {
  FAILED_DELIVERY_TAGGED
  RETURNING_TO_SELLER
  RETURN_REQUESTED
  RETURN_IN_TRANSIT
  COURIER_RETURNED
  DISPUTED
  RESOLVED_REFUNDED
  CANCELLED_RETURN
}

enum PhysicalCondition {
  GOOD_RESTOCKABLE
  DAMAGED_PACKAGING
  DAMAGED_ITEM
  WRONG_OR_SWAPPED_ITEM
  MISSING_PIECE
}

model OwnerUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model StaffMember {
  id        String         @id @default(cuid())
  name      String         @unique
  pinHash   String
  active    Boolean        @default(true)
  scans     PhysicalScan[]
  createdAt DateTime       @default(now())

  failedPinAttempts Int       @default(0)
  pinLockedUntil    DateTime?
}

model ShopConnection {
  id                 String              @id @default(cuid())
  platform           Platform
  shopId             String              @unique
  shopName           String
  shopCipher         String?
  accessToken        String?
  refreshToken       String?
  tokenExpiresAt     DateTime?
  /// Set when token refresh starts failing; cleared on the next success. Used to alert once.
  tokenErrorAt       DateTime?
  tokenError         String?
  /// Per-shop switch for anything that changes the shop (ship, print, stock). Off by default.
  writesEnabled      Boolean             @default(false)
  /// Orders updated up to this time are in the ledger. Advanced one window at a time.
  ordersSyncedTo     DateTime?
  /// Return/refund requests updated up to this time are synced.
  returnsSyncedTo    DateTime?
  /// Shopee wallet transactions created up to this time are synced.
  walletSyncedTo     DateTime?
  /// Last money sync. Money is pulled at most every 15 minutes.
  walletCheckedAt    DateTime?
  /// Read-only starting-stock import: null | RUNNING | DONE. Runs in ticks, resumable.
  stockImportStatus  String?
  /// Shopee offset / TikTok page token for the next page of listings.
  stockImportCursor  String?
  stockImportedAt    DateTime?
  walletTransactions WalletTransaction[]
  lastSyncedAt       DateTime?
  orders             Order[]
  listings           ListingVariant[]
  isDemo             Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  parcels            ReturnParcel[]
}

model ReturnParcel {
  id                    String         @id @default(cuid())
  shopConnectionId      String
  shopConnection        ShopConnection @relation(fields: [shopConnectionId], references: [id], onDelete: Cascade)
  platform              Platform
  orderSn               String
  returnSn              String?
  forwardTrackingNumber String?
  rtsTrackingNumber     String?
  courier               String

  category          ReturnCategory
  digitalStatus     DigitalStatus
  returnReason      String?
  disputeDeadlineAt DateTime?

  itemSummary   String
  variationName String?
  quantity      Int     @default(1)
  itemImageUrl  String?
  itemsJson     Json?

  orderTotalPhp        Decimal @db.Decimal(10, 2)
  estimatedUnitCostPhp Decimal @db.Decimal(10, 2)

  orderCreatedAt            DateTime?
  digitalReturnTaggedAt     DateTime?
  courierReturnedToSellerAt DateTime?
  physicallyReceivedAt      DateTime?

  physicalCondition PhysicalCondition?
  disputeDraft      String?            @db.Text

  /// "F:<orderSn>" for a failed delivery (incl. Shopee Return on the Spot),
  /// "R:<returnSn>" for a buyer return. Several returns on one order stay separate.
  dedupeKey             String
  /// False for refund-only returns: nothing is shipped back, so it can't be missing/overdue.
  expectsPhysicalReturn Boolean   @default(true)
  /// Shopee return_refund_request_type: 0 normal, 1 in-transit, 2 Return on the Spot.
  returnRequestType     Int?
  /// TikTok return_type, or Shopee "RETURN_AND_REFUND" / "REFUND_ONLY".
  returnType            String?
  /// When courier tracking was last checked. Open parcels are refreshed however old.
  lastCheckedAt         DateTime?

  events ReturnEvent[]
  scans  PhysicalScan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platform, dedupeKey])
  @@index([platform, orderSn])
  @@index([lastCheckedAt])
  @@index([forwardTrackingNumber])
  @@index([rtsTrackingNumber])
  @@index([digitalReturnTaggedAt])
  @@index([courierReturnedToSellerAt])
  @@index([physicallyReceivedAt])
  @@index([category, digitalStatus])
}

model ReturnEvent {
  id             String       @id @default(cuid())
  parcelId       String
  parcel         ReturnParcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  source         String
  rawStatus      String
  description    String?
  eventTimestamp DateTime
  rawPayloadJson Json?
  createdAt      DateTime     @default(now())

  @@unique([parcelId, source, rawStatus, eventTimestamp])
  @@index([parcelId, eventTimestamp])
}

model PhysicalScan {
  id             String            @id @default(cuid())
  parcelId       String
  parcel         ReturnParcel      @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  staffMemberId  String
  staffMember    StaffMember       @relation(fields: [staffMemberId], references: [id])
  scannedBarcode String
  condition      PhysicalCondition
  notes          String?
  photoUrls      String[]
  scannedAt      DateTime          @default(now())

  @@index([scannedAt])
}

model ImportJob {
  id           String   @id @default(cuid())
  fileName     String
  sourceHint   String
  totalRows    Int
  importedRows Int
  skippedRows  Int
  createdAt    DateTime @default(now())
}

model AppSettings {
  id                        String   @id @default("default")
  defaultUnitCostPhp        Decimal  @default(82.00) @db.Decimal(10, 2)
  defaultSellingPrice       Decimal  @default(199.00) @db.Decimal(10, 2)
  overdueRtsDays            Int      @default(10)
  /// What one return/failed-delivery shipment costs the seller (Shopee PH charges it since June 2025).
  returnShippingEstimatePhp Decimal  @default(40.00) @db.Decimal(10, 2)
  /// Pieces held back from what the shops show, so a late sync can't oversell.
  stockSafetyBuffer         Int      @default(0)
  telegramChatId            String?
  telegramDailyBriefUtc     String   @default("12:00")
  updatedAt                 DateTime @updatedAt
}

/// One marketplace order. Kept current by incremental sync; completed and
/// cancelled orders are deleted after 90 days to stay inside the free database.
model Order {
  id                      String         @id @default(cuid())
  shopConnectionId        String
  shopConnection          ShopConnection @relation(fields: [shopConnectionId], references: [id], onDelete: Cascade)
  platform                Platform
  orderSn                 String
  /// Raw platform status, e.g. READY_TO_SHIP (Shopee) or AWAITING_SHIPMENT (TikTok).
  status                  String
  isCod                   Boolean        @default(false)
  totalPhp                Decimal        @db.Decimal(12, 2)
  platformCreatedAt       DateTime
  platformUpdatedAt       DateTime
  /// Shopee pickup_done_time / TikTok rts_time.
  shippedAt               DateTime?
  cancelBy                String?
  cancelReason            String?
  /// Set once the order left the "unshipped" statuses and its stock movement was recorded.
  stockRecordedAt         DateTime?
  /// Set once a cancelled-after-shipping order has been checked for a failed delivery.
  failedDeliveryCheckedAt DateTime?
  lines                   OrderLine[]
  packages                Package[]
  syncedAt                DateTime       @updatedAt

  @@unique([platform, orderSn])
  @@index([shopConnectionId, status])
  @@index([status, platformUpdatedAt])
  @@index([platformCreatedAt])
}

model OrderLine {
  id            String  @id @default(cuid())
  orderId       String
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Shopee item_id / TikTok product_id
  listingId     String
  /// Shopee model_id ("0" if none) / TikTok sku_id
  variationId   String
  name          String
  variationName String?
  imageUrl      String?
  quantity      Int
  unitPricePhp  Decimal @db.Decimal(12, 2)

  @@index([orderId])
  @@index([listingId, variationId])
}

model Package {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Shopee package_number / TikTok package id
  packageNumber  String
  trackingNumber String?
  carrier        String?
  channelId      String?
  /// Raw platform package/logistics status.
  status         String?

  @@unique([orderId, packageNumber])
  @@index([trackingNumber])
}

/// Every listing variation seen on either shop. Filled from order lines.
model ListingVariant {
  id               String          @id @default(cuid())
  shopConnectionId String
  shopConnection   ShopConnection  @relation(fields: [shopConnectionId], references: [id], onDelete: Cascade)
  platform         Platform
  listingId        String
  variationId      String
  name             String
  variationName    String?
  imageUrl         String?
  lastSeenAt       DateTime
  /// The real garment this listing variation sells. Every listing variation
  /// gets its own on first sight; the owner links twins across shops.
  garmentVariantId String?
  garmentVariant   GarmentVariant? @relation(fields: [garmentVariantId], references: [id], onDelete: SetNull)
  /// "Available to sell" from the shop at the last stock import (excludes stock reserved by unshipped orders).
  availableStock   Int?
  stockCheckedAt   DateTime?
  /// TikTok warehouse the SKU's stock lives in (needed to update it).
  warehouseId      String?
  /// Last stock number sent to the shop, and how that went.
  pushedStock      Int?
  pushedAt         DateTime?
  pushError        String?
  pushFailures     Int             @default(0)

  @@unique([shopConnectionId, listingId, variationId])
  @@index([garmentVariantId])
}

/// One real item across both shops, e.g. "Ribbed Top".
model Garment {
  id        String           @id @default(cuid())
  name      String
  imageUrl  String?
  variants  GarmentVariant[]
  createdAt DateTime         @default(now())
}

/// One real colour/size of a garment, e.g. "Black, M". Holds the stock count.
model GarmentVariant {
  id                 String           @id @default(cuid())
  garmentId          String
  garment            Garment          @relation(fields: [garmentId], references: [id], onDelete: Cascade)
  label              String
  listings           ListingVariant[]
  /// Owner-confirmed starting count (Task 7). The stock ledger starts from it.
  startingStock      Int?
  startingStockSetAt DateTime?
  movements          StockMovement[]
  createdAt          DateTime         @default(now())

  @@index([garmentId])
}

/// Prevents two worker ticks from running at once. A tick that finds the lock
/// held sets `rerunRequested` so the running tick does one more pass.
model WorkerLock {
  id             String   @id
  lockedUntil    DateTime
  holder         String?
  rerunRequested Boolean  @default(false)
}

enum MoneyKind {
  /// Order income credited to the seller (Shopee escrow released / TikTok statement paid)
  CREDIT
  ADS
  ADJUSTMENT
  WITHDRAWAL
  OTHER
}

/// Shopee wallet transactions and paid TikTok statements. "Credited today"
/// is the sum of CREDIT rows whose occurredAt falls on the Manila day.
model WalletTransaction {
  id               String         @id @default(cuid())
  shopConnectionId String
  shopConnection   ShopConnection @relation(fields: [shopConnectionId], references: [id], onDelete: Cascade)
  platform         Platform
  /// Shopee transaction_id / TikTok statement id
  externalId       String
  kind             MoneyKind
  rawType          String
  amountPhp        Decimal        @db.Decimal(14, 2)
  /// Shopee create_time / TikTok payment_time
  occurredAt       DateTime
  orderSn          String?

  @@unique([platform, externalId])
  @@index([occurredAt, kind])
}

enum StockReason {
  /// Owner's starting count
  INITIAL
  /// Staff recorded a supplier delivery
  SUPPLIER_IN
  /// A return scanned as good / restockable
  RETURN_GOOD
  /// Courier picked up an order
  SHIPPED
  /// Owner recount
  ADJUSTMENT
}

/// Pieces on the shelf = sum of movements. Each movement has a unique source
/// key, so recording the same event twice changes nothing.
model StockMovement {
  id               String         @id @default(cuid())
  garmentVariantId String
  garmentVariant   GarmentVariant @relation(fields: [garmentVariantId], references: [id], onDelete: Cascade)
  delta            Int
  reason           StockReason
  sourceKey        String         @unique
  note             String?
  staffMemberId    String?
  createdAt        DateTime       @default(now())

  @@index([garmentVariantId])
}
