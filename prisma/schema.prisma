generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Platform {
  SHOPEE
  TIKTOK
}

enum ReturnCategory {
  FAILED_DELIVERY
  RETURN_REFUND
}

enum DigitalStatus {
  FAILED_DELIVERY_TAGGED
  RETURNING_TO_SELLER
  RETURN_REQUESTED
  RETURN_IN_TRANSIT
  COURIER_RETURNED
  DISPUTED
  RESOLVED_REFUNDED
  CANCELLED_RETURN
}

/// Owner-tracked dispute with the marketplace for a missing / damaged return.
enum DisputeStatus {
  NONE
  FILED
  WON
  LOST
}

enum PhysicalCondition {
  GOOD_RESTOCKABLE
  DAMAGED_PACKAGING
  DAMAGED_ITEM
  WRONG_OR_SWAPPED_ITEM
  MISSING_PIECE
}

model OwnerUser {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String
  name                String
  failedLoginAttempts Int       @default(0)
  loginLockedUntil    DateTime?
  createdAt           DateTime  @default(now())
}

model StaffMember {
  id             String         @id @default(cuid())
  name           String         @unique
  pinHash        String
  active         Boolean        @default(true)
  tokenVersion   Int            @default(1)
  scans          PhysicalScan[]
  packedPackages Package[]
  createdAt      DateTime       @default(now())

  failedPinAttempts Int       @default(0)
  pinLockedUntil    DateTime?
}

model ShopConnection {
  id                 String              @id @default(cuid())
  platform           Platform
  shopId             String              @unique
  shopName           String
  shopCipher         String?
  accessToken        String?
  refreshToken       String?
  tokenExpiresAt     DateTime?
  /// Set when token refresh starts failing; cleared on the next success. Used to alert once.
  tokenErrorAt       DateTime?
  tokenError         String?
  /// Per-shop switch for anything that changes the shop (ship, print, stock). Off by default.
  writesEnabled      Boolean             @default(false)
  /// Orders updated up to this time are in the ledger. Advanced one window at a time.
  ordersSyncedTo     DateTime?
  /// Return/refund requests updated up to this time are synced.
  returnsSyncedTo    DateTime?
  /// Shopee wallet transactions created up to this time are synced.
  walletSyncedTo     DateTime?
  /// Last money sync. Money is pulled at most every 15 minutes.
  walletCheckedAt    DateTime?
  /// Read-only starting-stock import: null | RUNNING | DONE. Runs in ticks, resumable.
  stockImportStatus  String?
  /// Shopee offset / TikTok page token for the next page of listings.
  stockImportCursor  String?
  stockImportedAt    DateTime?
  walletTransactions WalletTransaction[]
  lastSyncedAt       DateTime?
  orders             Order[]
  listings           ListingVariant[]
  isDemo             Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  parcels            ReturnParcel[]
  chats              ChatConversation[]
  /// First time the shop's chats loaded from the platform. Until then Chats shows sample chats.
  chatAccessAt       DateTime?
  /// Last time we asked the platform for changed chats (throttles the checks).
  chatsCheckedAt     DateTime?
}

enum ChatSender {
  BUYER
  SELLER
  /// The platform's auto-reply bot (TikTok "ROBOT").
  ROBOT
  /// Platform notices ("Chat assigned to an agent").
  SYSTEM
}

enum ChatMessageKind {
  TEXT
  IMAGE
  ORDER_CARD
  PRODUCT_CARD
  OTHER
}

enum ChatMessageStatus {
  SENDING
  SENT
  FAILED
}

/// One buyer chat on a shop. Sample chats belong to the demo shops and are
/// removed with them. Deleted 90 days after the last message.
model ChatConversation {
  id                 String         @id @default(cuid())
  shopConnectionId   String
  shopConnection     ShopConnection @relation(fields: [shopConnectionId], references: [id], onDelete: Cascade)
  platform           Platform
  /// Shopee conversation_id / TikTok conversation id ("demo-..." for sample chats).
  externalId         String
  buyerName          String
  buyerAvatarUrl     String?
  /// Order the chat is about, when the platform tells us.
  orderSn            String?
  /// Sample chats only: the order card shown beside the chat.
  sampleOrder        Json?
  lastMessageAt      DateTime
  lastMessagePreview String         @default("")
  unreadCount        Int            @default(0)
  /// False when the platform no longer lets the shop reply in this chat.
  canReply           Boolean        @default(true)
  /// Last time this chat's messages were fetched from the platform.
  remoteCheckedAt    DateTime?
  messages           ChatMessage[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@unique([shopConnectionId, externalId])
  @@index([platform, lastMessageAt])
}

model ChatMessage {
  id             String            @id @default(cuid())
  conversationId String
  conversation   ChatConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// Platform message id; null until a reply is accepted by the shop.
  externalId     String?
  sender         ChatSender
  kind           ChatMessageKind
  text           String?
  imageUrl       String?
  /// Order or product card details (name, photo, order number).
  cardData       Json?
  sentAt         DateTime
  status         ChatMessageStatus @default(SENT)
  /// Set by the app for replies, so a retried send never posts twice.
  clientKey      String?           @unique

  @@unique([conversationId, externalId])
  @@index([conversationId, sentAt])
}

model ReturnParcel {
  id                    String         @id @default(cuid())
  shopConnectionId      String
  shopConnection        ShopConnection @relation(fields: [shopConnectionId], references: [id], onDelete: Cascade)
  platform              Platform
  orderSn               String
  returnSn              String?
  forwardTrackingNumber String?
  rtsTrackingNumber     String?
  courier               String

  category          ReturnCategory
  digitalStatus     DigitalStatus
  returnReason      String?
  disputeDeadlineAt DateTime?

  itemSummary   String
  variationName String?
  quantity      Int     @default(1)
  itemImageUrl  String?
  itemsJson     Json?

  orderTotalPhp        Decimal @db.Decimal(10, 2)
  estimatedUnitCostPhp Decimal @db.Decimal(10, 2)

  orderCreatedAt            DateTime?
  digitalReturnTaggedAt     DateTime?
  courierReturnedToSellerAt DateTime?
  physicallyReceivedAt      DateTime?

  physicalCondition PhysicalCondition?
  disputeDraft      String?            @db.Text

  /// Owner's dispute lifecycle with the marketplace (Phase 3).
  disputeStatus  DisputeStatus @default(NONE)
  disputeFiledAt DateTime?
  disputeRef     String?
  /// What the marketplace paid back after a won dispute.
  reimbursedPhp  Decimal?      @db.Decimal(10, 2)
  /// Owner closed the case by hand ("Found" / "Settled"). Resolved parcels are never Missing or Overdue.
  resolvedAt     DateTime?
  resolvedNote   String?

  /// "F:<orderSn>" for a failed delivery (incl. Shopee Return on the Spot),
  /// "R:<returnSn>" for a buyer return. Several returns on one order stay separate.
  dedupeKey             String
  /// False for refund-only returns: nothing is shipped back, so it can't be missing/overdue.
  expectsPhysicalReturn Boolean   @default(true)
  /// Shopee return_refund_request_type: 0 normal, 1 in-transit, 2 Return on the Spot.
  returnRequestType     Int?
  /// TikTok return_type, or Shopee "RETURN_AND_REFUND" / "REFUND_ONLY".
  returnType            String?
  /// When courier tracking was last checked. Open parcels are refreshed however old.
  lastCheckedAt         DateTime?

  events ReturnEvent[]
  scans  PhysicalScan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platform, dedupeKey])
  @@index([platform, orderSn])
  @@index([lastCheckedAt])
  @@index([forwardTrackingNumber])
  @@index([rtsTrackingNumber])
  @@index([digitalReturnTaggedAt])
  @@index([courierReturnedToSellerAt])
  @@index([physicallyReceivedAt])
  @@index([category, digitalStatus])
  @@index([disputeDeadlineAt])
}

model ReturnEvent {
  id             String       @id @default(cuid())
  parcelId       String
  parcel         ReturnParcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  source         String
  rawStatus      String
  description    String?
  eventTimestamp DateTime
  rawPayloadJson Json?
  createdAt      DateTime     @default(now())

  @@unique([parcelId, source, rawStatus, eventTimestamp])
  @@index([parcelId, eventTimestamp])
}

model PhysicalScan {
  id             String            @id @default(cuid())
  parcelId       String
  parcel         ReturnParcel      @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  staffMemberId  String
  staffMember    StaffMember       @relation(fields: [staffMemberId], references: [id])
  scannedBarcode String
  condition      PhysicalCondition
  notes          String?
  photoUrls      String[]
  scannedAt      DateTime          @default(now())
  /// Made on the phone per save, so a retry on flaky Wi-Fi is recorded once.
  clientKey      String?           @unique

  @@index([scannedAt])
  @@index([parcelId, scannedAt])
}

model ImportJob {
  id           String   @id @default(cuid())
  fileName     String
  sourceHint   String
  totalRows    Int
  importedRows Int
  skippedRows  Int
  createdAt    DateTime @default(now())
}

model AppSettings {
  id                        String   @id @default("default")
  defaultUnitCostPhp        Decimal  @default(82.00) @db.Decimal(10, 2)
  defaultSellingPrice       Decimal  @default(199.00) @db.Decimal(10, 2)
  overdueRtsDays            Int      @default(10)
  /// What one return/failed-delivery shipment costs the seller (Shopee PH charges it since June 2025).
  returnShippingEstimatePhp Decimal  @default(40.00) @db.Decimal(10, 2)
  /// Pieces held back from what the shops show, so a late sync can't oversell.
  stockSafetyBuffer         Int      @default(0)
  telegramChatId            String?
  telegramDailyBriefUtc     String   @default("12:00")
  /// Manila date ("2026-11-21") the 8 PM brief was last sent, so it goes out once a day.
  dailyBriefSentOn          String?
  /// Parcels returned to seller before this timestamp are pre-go-live history and excluded from "Missing" alerts.
  missingSinceAt            DateTime?
  /// Manila wave times, "HH:MM" comma-separated.
  waveTimes                 String   @default("08:30,12:30,15:30")
  /// Ship waves at those times without a tap. Off until the owner turns it on.
  wavesAutoEnabled          Boolean  @default(false)
  /// Last wave slot that fired ("2026-11-21 08:30"), so each slot runs once.
  lastWaveSlot              String?
  /// Print our own one-sticker waybill (shop's courier section + our item list) instead of the shop's label as-is.
  customWaybillEnabled      Boolean  @default(false)
  updatedAt                 DateTime @updatedAt
}

/// One marketplace order. Kept current by incremental sync; completed and
/// cancelled orders are deleted after 90 days to stay inside the free database.
model Order {
  id                      String         @id @default(cuid())
  shopConnectionId        String
  shopConnection          ShopConnection @relation(fields: [shopConnectionId], references: [id], onDelete: Cascade)
  platform                Platform
  orderSn                 String
  /// Raw platform status, e.g. READY_TO_SHIP (Shopee) or AWAITING_SHIPMENT (TikTok).
  status                  String
  isCod                   Boolean        @default(false)
  totalPhp                Decimal        @db.Decimal(12, 2)
  platformCreatedAt       DateTime
  platformUpdatedAt       DateTime
  /// Shopee pickup_done_time / TikTok rts_time.
  shippedAt               DateTime?
  cancelBy                String?
  cancelReason            String?
  /// Buyer asked to cancel (Shopee IN_CANCEL / TikTok is_buyer_request_cancel). Never ship these.
  cancelRequested         Boolean        @default(false)
  /// Set once the order left the "unshipped" statuses and its stock movement was recorded.
  stockRecordedAt         DateTime?
  /// Set once a cancelled-after-shipping order has been checked for a failed delivery.
  failedDeliveryCheckedAt DateTime?
  lines                   OrderLine[]
  packages                Package[]
  syncedAt                DateTime       @updatedAt

  @@unique([platform, orderSn])
  @@index([shopConnectionId, status])
  @@index([status, platformUpdatedAt])
  @@index([platformCreatedAt])
}

model OrderLine {
  id            String  @id @default(cuid())
  orderId       String
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Shopee item_id / TikTok product_id
  listingId     String
  /// Shopee model_id ("0" if none) / TikTok sku_id
  variationId   String
  name          String
  variationName String?
  imageUrl      String?
  quantity      Int
  unitPricePhp  Decimal @db.Decimal(12, 2)

  @@index([orderId])
  @@index([listingId, variationId])
}

model Package {
  id              String       @id @default(cuid())
  orderId         String
  order           Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Shopee package_number / TikTok package id
  packageNumber   String
  trackingNumber  String?
  carrier         String?
  channelId       String?
  /// Raw platform package/logistics status.
  status          String?
  /// Set when warehouse staff scans/verifies the printed label at the packing table.
  packedAt        DateTime?
  packedByStaffId String?
  packedByStaff   StaffMember? @relation(fields: [packedByStaffId], references: [id], onDelete: SetNull)
  waveItems       WaveItem[]

  @@unique([orderId, packageNumber])
  @@index([trackingNumber])
  @@index([packedAt])
}

/// Every listing variation seen on either shop. Filled from order lines.
model ListingVariant {
  id               String          @id @default(cuid())
  shopConnectionId String
  shopConnection   ShopConnection  @relation(fields: [shopConnectionId], references: [id], onDelete: Cascade)
  platform         Platform
  listingId        String
  variationId      String
  name             String
  variationName    String?
  imageUrl         String?
  lastSeenAt       DateTime
  /// The real garment this listing variation sells. Every listing variation
  /// gets its own on first sight; the owner links twins across shops.
  garmentVariantId String?
  garmentVariant   GarmentVariant? @relation(fields: [garmentVariantId], references: [id], onDelete: SetNull)
  /// "Available to sell" from the shop at the last stock import (excludes stock reserved by unshipped orders).
  availableStock   Int?
  stockCheckedAt   DateTime?
  /// TikTok warehouse the SKU's stock lives in (needed to update it).
  warehouseId      String?
  /// Last stock number sent to the shop, and how that went.
  pushedStock      Int?
  pushedAt         DateTime?
  pushError        String?
  pushFailures     Int             @default(0)

  @@unique([shopConnectionId, listingId, variationId])
  @@index([garmentVariantId])
}

/// One real item across both shops, e.g. "Ribbed Top".
model Garment {
  id                String           @id @default(cuid())
  name              String
  imageUrl          String?
  variants          GarmentVariant[]
  /// Hidden from the Items list and stock alerts (discontinued). Stock keeps syncing.
  archivedAt        DateTime?
  /// Optional overrides; null = use the shop-wide default from Settings.
  unitCostPhp       Decimal?         @db.Decimal(10, 2)
  sellingPricePhp   Decimal?         @db.Decimal(10, 2)
  /// "Low stock" at or below this many available (default 5).
  lowStockThreshold Int?
  /// Pieces held back from the shops for this garment (default: Settings buffer).
  safetyBuffer      Int?
  /// Shelf / bin label shown to packers, e.g. "A3".
  binLocation       String?
  createdAt         DateTime         @default(now())
}

/// One real colour/size of a garment, e.g. "Black, M". Holds the stock count.
model GarmentVariant {
  id                 String           @id @default(cuid())
  garmentId          String
  garment            Garment          @relation(fields: [garmentId], references: [id], onDelete: Cascade)
  label              String
  listings           ListingVariant[]
  /// Owner-confirmed starting count (Task 7). The stock ledger starts from it.
  startingStock      Int?
  startingStockSetAt DateTime?
  movements          StockMovement[]
  createdAt          DateTime         @default(now())

  @@index([garmentId])
}

/// Prevents two worker ticks from running at once. A tick that finds the lock
/// held sets `rerunRequested` so the running tick does one more pass.
model WorkerLock {
  id             String   @id
  lockedUntil    DateTime
  holder         String?
  rerunRequested Boolean  @default(false)
}

enum MoneyKind {
  /// Order income credited to the seller (Shopee escrow released / TikTok statement paid)
  CREDIT
  ADS
  ADJUSTMENT
  WITHDRAWAL
  OTHER
}

/// Shopee wallet transactions and paid TikTok statements. "Credited today"
/// is the sum of CREDIT rows whose occurredAt falls on the Manila day.
model WalletTransaction {
  id               String         @id @default(cuid())
  shopConnectionId String
  shopConnection   ShopConnection @relation(fields: [shopConnectionId], references: [id], onDelete: Cascade)
  platform         Platform
  /// Shopee transaction_id / TikTok statement id
  externalId       String
  kind             MoneyKind
  rawType          String
  amountPhp        Decimal        @db.Decimal(14, 2)
  /// Shopee create_time / TikTok payment_time
  occurredAt       DateTime
  orderSn          String?

  @@unique([platform, externalId])
  @@index([occurredAt, kind])
}

enum StockReason {
  /// Owner's starting count
  INITIAL
  /// Staff recorded a supplier delivery
  SUPPLIER_IN
  /// A return scanned as good / restockable
  RETURN_GOOD
  /// Courier picked up an order
  SHIPPED
  /// Owner recount
  ADJUSTMENT
}

/// Pieces on the shelf = sum of movements. Each movement has a unique source
/// key, so recording the same event twice changes nothing.
model StockMovement {
  id               String         @id @default(cuid())
  garmentVariantId String
  garmentVariant   GarmentVariant @relation(fields: [garmentVariantId], references: [id], onDelete: Cascade)
  delta            Int
  reason           StockReason
  sourceKey        String         @unique
  note             String?
  staffMemberId    String?
  createdAt        DateTime       @default(now())

  @@index([garmentVariantId, createdAt])
  @@index([createdAt])
}

enum PrintJobKind {
  TEST
  LABEL
  PICK_LIST
}

enum PrintJobStatus {
  QUEUED
  PRINTING
  PRINTED
  FAILED
}

/// The warehouse PC running the print agent. Authenticates with a token whose
/// SHA-256 is stored here; the token itself is shown to the owner once.
model PrintDevice {
  id           String     @id @default(cuid())
  name         String
  tokenHash    String     @unique
  paused       Boolean    @default(false)
  lastSeenAt   DateTime?
  agentVersion String?
  printerName  String?
  /// Windows printer state from the agent ("Normal", "Offline", "PaperOut", ...).
  printerStatus   String?
  /// Nightly pg_dump on the PC: last success, last error, size of the last file.
  lastBackupAt    DateTime?
  lastBackupError String?
  lastBackupBytes Int?
  createdAt    DateTime   @default(now())
  jobs         PrintJob[]
}

/// One row per alert key so a proactive Telegram alert is sent once per episode.
model AlertLog {
  key    String   @id
  sentAt DateTime
  /// Free text for debugging ("3 parcels", "printer offline 12m").
  detail String?
}

model PrintJob {
  id              String         @id @default(cuid())
  kind            PrintJobKind
  status          PrintJobStatus @default(QUEUED)
  title           String
  /// Package for LABEL jobs (Tasks 11–12).
  packageId       String?
  /// Wave this job belongs to (Tasks 10–13); position is its order within the wave.
  waveId          String?
  position        Int            @default(0)
  attempts        Int            @default(0)
  error           String?
  deviceId        String?
  device          PrintDevice?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  claimedAt       DateTime?
  printedAt       DateTime?
  docUrl          String?
  docExpiresAt    DateTime?
  batchPackageIds String[]       @default([])
  createdAt       DateTime       @default(now())

  @@index([status, createdAt])
  @@index([status, claimedAt])
  @@index([waveId])
}

enum WaveStatus {
  /// Read-only plan: what a wave would ship. Nothing sent to the shops.
  PREVIEW
  RUNNING
  DONE
  CANCELLED
}

/// One package's progress through a wave. Shipping states are used from Task 11.
enum WaveItemStatus {
  READY
  SHIPPING_ARRANGED
  TRACKING_ASSIGNED
  LABEL_READY
  PRINTED
  SKIPPED_CANCELLED
  FAILED
}

model Wave {
  id          String     @id @default(cuid())
  status      WaveStatus @default(PREVIEW)
  /// MANUAL (owner tapped) or SCHEDULED
  trigger     String     @default("MANUAL")
  parcelCount Int
  /// Groups, pick-list lines and skip counts, frozen when the wave was planned.
  summaryJson Json
  createdAt   DateTime   @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  items       WaveItem[]

  @@index([status, createdAt])
}

model WaveItem {
  id              String         @id @default(cuid())
  waveId          String
  wave            Wave           @relation(fields: [waveId], references: [id], onDelete: Cascade)
  packageId       String
  package         Package        @relation(fields: [packageId], references: [id], onDelete: Cascade)
  orderId         String
  platform        Platform
  /// Packages with the same key are shipped together (same shop + courier channel).
  groupKey        String
  /// Packing / label order within the wave.
  position        Int
  status          WaveItemStatus @default(READY)
  /// Set to the packageId while this item may ship it. Unique, so a package is
  /// never in two running waves (Tasks 11–13). Null for previews.
  activePackageId String?        @unique
  trackingNumber  String?
  error           String?
  /// Set just before asking the shop to arrange shipment. If the app crashes
  /// or the call times out, this says "we may have shipped it": the next
  /// fresh re-check decides, and an arranged order is then treated as ours.
  shipRequestedAt DateTime?
  /// Label document requested from the shop (waiting for it to be ready).
  docRequestedAt  DateTime?
  /// Tries in the current step; reset on every step change.
  attempts        Int            @default(0)
  /// Don't retry this item before this time.
  nextAttemptAt   DateTime?
  updatedAt       DateTime       @updatedAt

  @@index([waveId, position])
  @@index([status, nextAttemptAt])
  @@index([packageId])
}
