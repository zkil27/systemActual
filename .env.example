# Database (Supabase PostgreSQL)
# DATABASE_URL = Supabase Transaction Pooler (port 6543, MUST end with ?pgbouncer=true)
# DIRECT_URL   = Supabase Session Pooler / Direct connection (port 5432, used for prisma db push / migrate)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Session signing secret. REQUIRED, 32+ random characters. The app refuses to sign sessions without it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# Key for the encrypted shop tokens (32+ chars). Every copy of the app that uses
# the same database (local dev and Vercel) must have the SAME value, or the
# others can't read the tokens. Falls back to AUTH_SECRET when unset.
TOKEN_ENCRYPTION_KEY=""

# Developer tools (/dev): owner-account emails allowed in, comma-separated.
# Empty = nobody. The shop owner's account should NOT be listed.
DEVELOPER_EMAILS=""

# Chats assistant automatic replies: off | all | comma list of TikTok conversation
# ids (test buyers). Everyone else only gets drafts the owner checks first.
AI_AUTOSEND_TIKTOK="off"

# Replies to real TikTok chats from Kyna Ops: off | all | comma list of TikTok
# conversation ids (test buyers). Sample chats always work.
CHAT_SEND_TIKTOK="off"

# Public app base URL (used for OAuth callbacks & Telegram links)
APP_BASE_URL="http://localhost:3000"

# Shopee Open Platform (Seller In-House App)
SHOPEE_PARTNER_ID=""
SHOPEE_PARTNER_KEY=""
# Push Mechanism Partner Key (Shopee Console → Push Mechanism → Push Partner Key; optional if same as SHOPEE_PARTNER_KEY)
SHOPEE_PUSH_PARTNER_KEY=""
# Live: https://partner.shopeemobile.com   Sandbox: https://openplatform.sandbox.test-stable.shopee.sg
# (Test keys are rejected by the old sandbox host partner.test-stable.shopeemobile.com with "Wrong sign".)
SHOPEE_BASE_URL="https://partner.shopeemobile.com"

# TikTok Shop Open API (Custom Seller App)
TIKTOK_APP_KEY=""
TIKTOK_APP_SECRET=""
# service_id is shown on the app page in Partner Center (App & Service); it's in the seller authorization link.
TIKTOK_SERVICE_ID=""
TIKTOK_SELLER_AUTH_URL="https://services.tiktokshop.com/open/authorize"
# Token API host (token/get and token/refresh)
TIKTOK_AUTH_URL="https://auth.tiktok-shops.com"
TIKTOK_API_BASE_URL="https://open-api.tiktokglobalshop.com"

# Optional. Lets `npm run dev:tick` call /api/worker/tick locally (and Vercel free cron via CRON_SECRET). 32+ random chars.
# In production the warehouse PC uses its printer code (Settings > Printer) instead.
WORKER_SECRET=""
CRON_SECRET=""

# Telegram Bot (Free via @BotFather)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""

# Web Push notifications (Free VAPID keys, works on iOS Home Screen PWA, Android & desktop)
# Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:ops@kyna.ph"

# Optional Vercel Blob storage for staff return proof photos (falls back to public/uploads locally)
BLOB_READ_WRITE_TOKEN=""
# Chats assistant AI, all free tiers, tried in this order. Leave a key empty to skip that service.
# Check them with: npm run ai:health
# Groq: console.groq.com/keys. Also turn on Zero Data Retention in the Groq console's data controls.
GROQ_API_KEY=""
# Cloudflare Workers AI: account ID (32 characters, dashboard sidebar) and an API token with "Workers AI: Read".
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_AI_TOKEN=""
# Optional. OpenRouter: openrouter.ai/settings/keys. Don't buy credits; set the key's credit limit to 0.
# Free models change often; comma list, tried in order.
OPENROUTER_API_KEY=""
OPENROUTER_MODELS="google/gemma-4-31b-it:free,openrouter/free"
# Optional. Gemini free (aistudio.google.com/apikey, no billing). Google may use free-tier content,
# so it only ever gets general questions with no buyer details. Daily limit: see AI Studio → Rate limits.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_DAILY_REQUESTS="20"
