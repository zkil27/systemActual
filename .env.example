# Database (Supabase PostgreSQL)
# DATABASE_URL = Supabase Transaction Pooler (port 6543, MUST end with ?pgbouncer=true)
# DIRECT_URL   = Supabase Session Pooler / Direct connection (port 5432, used for prisma db push / migrate)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Session signing secret (generate a random 32+ char string for production)
AUTH_SECRET="kyna-ops-dev-secret-change-in-production-32chars"

# Public app base URL (used for OAuth callbacks & Telegram links)
APP_BASE_URL="http://localhost:3000"

# Shopee Open Platform (Seller In-House App)
SHOPEE_PARTNER_ID=""
SHOPEE_PARTNER_KEY=""
SHOPEE_BASE_URL="https://partner.shopeemobile.com"

# TikTok Shop Open API (Custom Seller App)
TIKTOK_APP_KEY=""
TIKTOK_APP_SECRET=""
TIKTOK_AUTH_URL="https://auth.tiktok-shops.com"
TIKTOK_API_BASE_URL="https://open-api.tiktokglobalshop.com"

# Telegram Bot (Free via @BotFather)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""

# Optional Vercel Blob storage for staff return proof photos (falls back to public/uploads locally)
BLOB_READ_WRITE_TOKEN=""
